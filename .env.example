# Django
SECRET_KEY=your-secret-key-here-change-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Database (Supabase PostgreSQL)
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=your-supabase-db-password
DB_HOST=db.your-project-ref.supabase.co
DB_PORT=5432

# Media / Static
MEDIA_URL=/media/
STATIC_URL=/static/

# Wompi Payments (Colombia)
WOMPI_PUBLIC_KEY=pub_test_your_key_here
WOMPI_PRIVATE_KEY=prv_test_your_key_here
WOMPI_EVENTS_SECRET=your_events_secret
WOMPI_SANDBOX=True

# Email (optional, for order confirmations)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_HOST_USER=your@email.com
EMAIL_HOST_PASSWORD=your-app-password
DEFAULT_FROM_EMAIL=Palma Cayena <hola@palmacayena.com>

# Site
SITE_URL=http://localhost:8000
